<h2>8×8 颜色交替图</h2>
<table class="color-grid">
    <%
        for (int row = 0; row < 8; row++) {
    %>
    <tr>
        <%
            for (int col = 0; col < 8; col++) {
                String bgColor = (row + col) % 2 == 0 ? "#FFD700" : "#8B4513";
        %>
        <td style="background-color: <%= bgColor %>;"></td>
        <%
            }
        %>
    </tr>
    <%
        }
    %>
</table>

